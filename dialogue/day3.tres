script = ExtResource("1_7loct")
lines = Array[ExtResource("1_lssin")]([SubResource("Resource_iynej"), SubResource("Resource_f0rm1"), SubResource("Resource_chgku"), SubResource("Resource_p34yp"), SubResource("Resource_ieu4e"), SubResource("Resource_tfnuo"), SubResource("Resource_jp16a"), SubResource("Resource_hgtu5")])
