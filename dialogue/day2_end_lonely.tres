[sub_resource type="Resource" id="Resource_40k35"]
script = ExtResource("1_40k35")
text = "You didn’t come back."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_hvfq5"]
script = ExtResource("1_40k35")
text = "I tried to ignore it, but it kept getting worse."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_afmg5"]
script = ExtResource("1_40k35")
text = "That empty feeling."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_tqq5w"]
script = ExtResource("1_40k35")
text = "It’s different when you’re not here."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_l7wrx"]
script = ExtResource("1_40k35")
text = "Please don’t make me wait like that again."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

