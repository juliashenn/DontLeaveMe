[sub_resource type="Resource" id="Resource_pvs5j"]
script = ExtResource("1_pvs5j")
text = "You stayed out too long."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_p06tu"]
script = ExtResource("1_pvs5j")
text = "I kept thinking something happened to you."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_5yod7"]
script = ExtResource("1_pvs5j")
text = "Or that you just didn’t come back."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_5iomg"]
