[sub_resource type="Resource" id="Resource_3wh5s"]
script = ExtResource("1_3wh5s")
text = "You got away."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_j4ntd"]
script = ExtResource("1_3wh5s")
text = "...that’s okay."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_erlrh"]
script = ExtResource("1_3wh5s")
text = "I can wait."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_tfaj4"]
script = ExtResource("1_3wh5s")
text = "Someone else will come."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_g0dyo"]
script = ExtResource("1_3wh5s")
text = "They always do."
