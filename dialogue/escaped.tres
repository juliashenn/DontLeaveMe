[sub_resource type="Resource" id="Resource_17ob0"]
script = ExtResource("1_3wh5s")
text = "And next time."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_um55j"]
