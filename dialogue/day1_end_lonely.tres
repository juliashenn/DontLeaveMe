[gd_resource type="Resource" script_class="DialogueResource" load_steps=10 format=3 uid="uid://da552qkv6vkgo"]

[ext_resource type="Script" uid="uid://c1y04o8kyakix" path="res://Resources/DialogueLine.gd" id="1_7m74p"]
[ext_resource type="Script" uid="uid://ccc6dbr3u3w68" path="res://Resources/DialogueResource.gd" id="2_j3ryt"]

[sub_resource type="Resource" id="Resource_7m74p"]
script = ExtResource("1_7m74p")
text = "You didn't come back…"
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_j3ryt"]
script = ExtResource("1_7m74p")
text = "I was scared and lonely. "
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_kxde8"]
script = ExtResource("1_7m74p")
text = "It gets so quiet here without you. "
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_toqoh"]
script = ExtResource("1_7m74p")
text = "There are …things out there. I don't like them."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_er801"]
script = ExtResource("1_7m74p")
text = "… What if something took you?"
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_v88p5"]
script = ExtResource("1_7m74p")
text = "It's okay. I forgive you. "
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_badds"]
script = ExtResource("1_7m74p")
text = "But don’t do that again… Please"
metadata/_custom_type_script = "uid://c1y04o8kyakix"

