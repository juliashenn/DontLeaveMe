[sub_resource type="Resource" id="Resource_wsso0"]
script = ExtResource("1_ay1dd")
text = "You said you’d stay with me."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_u58tj"]
