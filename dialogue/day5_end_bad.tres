metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_66bll"]
script = ExtResource("1_ay1dd")
text = "Why didn’t you come back?"
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_c2d23"]
script = ExtResource("1_ay1dd")
text = "Did you finally decide you had enough of me?"
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_pngaw"]
script = ExtResource("1_ay1dd")
text = "Then why did you bother taking care of me?"
