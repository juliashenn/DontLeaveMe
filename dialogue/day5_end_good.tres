[gd_resource type="Resource" script_class="DialogueResource" load_steps=16 format=3 uid="uid://ccb582dl6vpj6"]

[ext_resource type="Script" uid="uid://c1y04o8kyakix" path="res://Resources/DialogueLine.gd" id="1_vrf57"]
[ext_resource type="Script" uid="uid://ccc6dbr3u3w68" path="res://Resources/DialogueResource.gd" id="2_ymbh2"]

[sub_resource type="Resource" id="Resource_vrf57"]
script = ExtResource("1_vrf57")
text = "Five days."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_ymbh2"]
script = ExtResource("1_vrf57")
text = "Five days you stayed with me."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_5rwu1"]
script = ExtResource("1_vrf57")
text = "You kept coming back."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_wamw3"]
script = ExtResource("1_vrf57")
text = "Over and over."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_37gyr"]
script = ExtResource("1_vrf57")
text = "Even when it was hard."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_wwphn"]
script = ExtResource("1_vrf57")
text = "Even when you were scared."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_582p4"]
script = ExtResource("1_vrf57")
text = "You stayed."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_vetb0"]
script = ExtResource("1_vrf57")
text = "With me."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_t2h1y"]
script = ExtResource("1_vrf57")
text = "That means you chose me."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_xqnkw"]
script = ExtResource("1_vrf57")
text = "So you won’t ever leave."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_lnvn2"]
script = ExtResource("1_vrf57")
text = "You’ll stay right here."
animation = "Buff"
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_3xvkd"]
script = ExtResource("1_vrf57")
text = "With me."
animation = ""
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_aiqan"]
script = ExtResource("1_vrf57")
text = "Forever."
animation = "BuffEat"
metadata/_custom_type_script = "uid://c1y04o8kyakix"

