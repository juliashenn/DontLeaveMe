[sub_resource type="Resource" id="Resource_hogax"]
script = ExtResource("1_hogax")
text = "You’re still here!"
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_ywcf0"]
