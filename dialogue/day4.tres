text = "Good."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_q48im"]
script = ExtResource("1_hogax")
text = "I heard something near the water."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_s8e3d"]
script = ExtResource("1_hogax")
text = "It didn’t sound right."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_xeafv"]
