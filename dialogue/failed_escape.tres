[gd_resource type="Resource" script_class="DialogueResource" load_steps=14 format=3 uid="uid://6x2xemt75hcj"]

[ext_resource type="Script" uid="uid://c1y04o8kyakix" path="res://Resources/DialogueLine.gd" id="1_m08dp"]
[ext_resource type="Script" uid="uid://ccc6dbr3u3w68" path="res://Resources/DialogueResource.gd" id="2_yisvo"]

[sub_resource type="Resource" id="Resource_3wh5s"]
script = ExtResource("1_m08dp")
text = "You tried to leave."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_j4ntd"]
script = ExtResource("1_m08dp")
text = "Even now."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_erlrh"]
script = ExtResource("1_m08dp")
text = "After everything."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_tfaj4"]
script = ExtResource("1_m08dp")
text = "I gave you a chance."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_g0dyo"]
script = ExtResource("1_m08dp")
text = "And you still ran."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_17ob0"]
script = ExtResource("1_m08dp")
text = "...that’s okay."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_um55j"]
script = ExtResource("1_m08dp")
text = "You don’t have to try anymore."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_m08dp"]
script = ExtResource("1_m08dp")
text = "I’ll keep you here."
animation = "Buff"
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_yisvo"]
script = ExtResource("1_m08dp")
text = "Where you belong."
animation = ""
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_m6uvl"]
script = ExtResource("1_m08dp")
text = "With me."
animation = ""
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_k31w6"]
script = ExtResource("1_m08dp")
text = "Forever."
animation = "BuffEat"
metadata/_custom_type_script = "uid://c1y04o8kyakix"

