[ext_resource type="Script" uid="uid://c1y04o8kyakix" path="res://Resources/DialogueLine.gd" id="1_eq06s"]
[ext_resource type="Script" uid="uid://ccc6dbr3u3w68" path="res://Resources/DialogueResource.gd" id="2_j12yn"]

[sub_resource type="Resource" id="Resource_vrf57"]
script = ExtResource("1_eq06s")
text = "You didn’t come back."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_ymbh2"]
script = ExtResource("1_eq06s")
text = "Every day."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_5rwu1"]
script = ExtResource("1_eq06s")
text = "You didn’t come back."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_wamw3"]
script = ExtResource("1_eq06s")
text = "I kept waiting."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_37gyr"]
script = ExtResource("1_eq06s")
text = "I kept trying to understand."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_wwphn"]
script = ExtResource("1_eq06s")
text = "Was it me?"
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_582p4"]
script = ExtResource("1_eq06s")
text = "Was I not enough?"
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_vetb0"]
script = ExtResource("1_eq06s")
text = "No."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_t2h1y"]
script = ExtResource("1_eq06s")
text = "It was you."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_xqnkw"]
script = ExtResource("1_eq06s")
text = "You kept leaving."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_lnvn2"]
script = ExtResource("1_eq06s")
text = "You kept choosing to leave."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_3xvkd"]
script = ExtResource("1_eq06s")
text = "So here's your chance."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_aiqan"]
script = ExtResource("1_eq06s")
text = "Try to escape. "
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_eq06s"]
script = ExtResource("1_eq06s")
text = "But just know if you get caught, you'll never come back."
animation = "IdleStanding"
metadata/_custom_type_script = "uid://c1y04o8kyakix"

