[gd_resource type="Resource" script_class="DialogueResource" load_steps=14 format=3 uid="uid://bodge82fii075"]

[ext_resource type="Script" uid="uid://ccc6dbr3u3w68" path="res://Resources/DialogueResource.gd" id="1_5cufq"]
[ext_resource type="Script" uid="uid://c1y04o8kyakix" path="res://Resources/DialogueLine.gd" id="1_m55op"]

[sub_resource type="Resource" id="Resource_6l5en"]
script = ExtResource("1_m55op")
text = "You stayed... you really stayed."
animation = "LyingDown"
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_m55op"]
script = ExtResource("1_m55op")
text = "I was a little scared you’d be gone when I woke up."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_soe18"]
script = ExtResource("1_m55op")
text = "I’m glad you’re still here with me."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_l21n4"]
script = ExtResource("1_m55op")
text = "I heard clucking earlier."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_0k73o"]
script = ExtResource("1_m55op")
text = "Some chickens must be nearby."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_sh6o8"]
script = ExtResource("1_m55op")
text = "I think they took the carrots."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_bm8nr"]
script = ExtResource("1_m55op")
text = "Could you bring me three again like you did yesterday?"
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_s8h3t"]
script = ExtResource("1_m55op")
text = "Just be careful around them."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_x3sqq"]
script = ExtResource("1_m55op")
text = "I don’t want anything taking you away."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_iio11"]
script = ExtResource("1_m55op")
text = "And... don’t take too long."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[sub_resource type="Resource" id="Resource_xtqlj"]
script = ExtResource("1_m55op")
text = "I don’t like waiting by myself."
metadata/_custom_type_script = "uid://c1y04o8kyakix"

[resource]
script = ExtResource("1_5cufq")
lines = Array[ExtResource("1_m55op")]([SubResource("Resource_6l5en"), SubResource("Resource_m55op"), SubResource("Resource_soe18"), SubResource("Resource_l21n4"), SubResource("Resource_0k73o"), SubResource("Resource_sh6o8"), SubResource("Resource_bm8nr"), SubResource("Resource_s8h3t"), SubResource("Resource_x3sqq"), SubResource("Resource_iio11"), SubResource("Resource_xtqlj")])
